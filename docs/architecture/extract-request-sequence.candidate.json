  "cards": [
    {
      "dot": "cyan",
      "title": "Happy Path",
      "items": [
        "Controller = CertificateController, Service = CertificateExtractionService, Extractor = DocumentTextExtractor, Parser = CertificateFieldParser",
        "Every hop is a plain synchronous method call inside one JVM",
        "The reply is one JSON object; no call leaves the host"
      ]
    },
    {
      "dot": "emerald",
      "title": "No External Service",
      "items": [
        "PDFBox and Tesseract are libraries, not services — there is no network hop and no AI or cloud OCR call",
        "PDFs first try embedded text, then fall back to rendering at 220 DPI and OCR (at most 5 pages)",
        "Images go straight to OCR with no PDFBox involvement"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure Surface",
      "items": [
        "Any validation failure throws ApiException before the extractor is reached",
        "GlobalExceptionHandler turns it into a structured error envelope with a code",
        "The full state-and-failure graph is in the extraction request lifecycle diagram"
      ]
    }
  ]
