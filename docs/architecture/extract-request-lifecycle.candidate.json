    { "id": "text-parsed", "from": "text_extracted", "to": "parsed", "label": "text ok" },
    { "id": "parsed-responded", "from": "parsed", "to": "responded", "label": "reply" },

    { "id": "received-rejected", "from": "received", "to": "rejected_request", "label": "blank, not base64, empty", "variant": "security" },
    { "id": "received-unsupported", "from": "received", "to": "unsupported_type", "label": "type not allowed", "variant": "security" },
    { "id": "decoded-too-large", "from": "decoded", "to": "file_too_large", "label": "over 10 MB", "variant": "security" },
    { "id": "decoded-mismatch", "from": "decoded", "to": "file_type_mismatch", "label": "sig ≠ fileType", "variant": "security" },
    { "id": "text-unreadable", "from": "text_extracted", "to": "unreadable", "label": "no text or ocr failed", "variant": "security" },
    { "id": "unreadable-retry", "from": "unreadable", "to": "text_extracted", "label": "fix runtime, retry", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Happy Path — Every Condition",
      "items": [
        "Received → Decoded: certificate and fileType are present, fileType is one of pdf, png, jpg, jpeg, and the payload decodes as Base64",
        "Decoded → Text Read: decoded size is at most 10 MB, and the magic bytes match the declared fileType",
        "Text Read → Parsed: non-blank text was obtained from the document",
        "Parsed → Response: six fields extracted, dates normalised to ISO, expiry compared with today's UTC date"
      ]
    },
    {
      "dot": "rose",
      "title": "Rejected — Every Code",
      "items": [
        "Blank certificate or fileType, or a body that is not valid JSON — 400 INVALID_REQUEST / INVALID_JSON",
        "Payload is not Base64, or decodes to zero bytes — 400 INVALID_BASE64 / EMPTY_FILE",
        "fileType outside pdf, png, jpg, jpeg — 400 UNSUPPORTED_FILE_TYPE",
        "Decoded size exceeds 10 MB — 413 FILE_TOO_LARGE",
        "Magic bytes do not match the declared fileType — 400 FILE_TYPE_MISMATCH",
        "No readable text in the document — 422 CERTIFICATE_UNREADABLE",
        "The Tesseract runtime is missing or the scan fails — 422 OCR_PROCESSING_FAILED"
      ]
    },
    {
      "dot": "amber",
      "title": "Terminal and Recoverable",
      "items": [
        "Every failure is terminal for that request — the client resubmits a corrected payload as a new request",
        "The 422 exit is the only one with a way back: the OCR error text asks you to install the runtime and retry",
        "Ambiguous expiry dates are not a failure — status is reported as unknown"
      ]
    }
  ]
}
