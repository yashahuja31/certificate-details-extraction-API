  "cards": [
    {
      "dot": "cyan",
      "title": "Main Path",
      "items": [
        "Six steps: accept, validate, extract text, parse fields, compute status, respond",
        "Every step is a method call inside one JVM — no queue, no retry loop, no persistence",
        "The Java CLI enters at the same first step by POSTing the same JSON body"
      ]
    },
    {
      "dot": "emerald",
      "title": "The OCR Branch",
      "items": [
        "PDFs first try embedded text; only when there is almost none does the renderer kick in",
        "Rendered pages go to Tesseract at 220 DPI, at most 5 pages per document",
        "PNG, JPG and JPEG images skip PDFBox entirely and go straight to OCR"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure Exits",
      "items": [
        "Validation failures exit as 400 or 413 before any parsing work is attempted",
        "A document that cannot be read, or an OCR runtime that is not installed, exits as 422",
        "Both exits return the same structured envelope; no stack trace or certificate text is echoed back"
      ]
    }
  ]
